# ==========================================
# pulseOps Backend Environment Template
# ==========================================
# Copy this file to .env and replace placeholders with your actual secrets.

# Server Port (default: 5000)
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/pulseOps?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/pulseOps?retryWrites=true&w=majority

# CORS Configuration (* allows all origins, or specify your frontend domain e.g. https://pulseops.dev)
CORS_ORIGIN=*

# JWT Authentication Configuration (Use a strong random 32+ character key in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=30d
