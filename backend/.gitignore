# ==========================================
# pulseOps Backend .gitignore
# ==========================================

# Dependencies
node_modules/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Allow example environment template
!.env.example

# Logs & Runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor & OS Artifacts
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
