# ==========================================
# pulseOps Frontend .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
dist-ssr/
build/

# Environment Variables & Local Overrides
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Allow example environment file
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS Artifacts
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
